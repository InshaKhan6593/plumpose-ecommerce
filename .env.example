# plumpose — copy to .env and fill in.

PAYLOAD_SECRET=generate-a-long-random-string

# Postgres. The app runs against Neon (pooled string, host contains -pooler).
# DATABASE_URL_DIRECT is the same without -pooler, for `pnpm payload migrate`.
# LOCAL_DATABASE_URL is Docker (README) — the integration tests always use it,
# and swapping it into DATABASE_URL works offline.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
DATABASE_URL_DIRECT=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
LOCAL_DATABASE_URL=postgres://plumpose:plumpose@localhost:5434/plumpose

NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Used to preview drafts from the admin.
PREVIEW_SECRET=change-me

# ---------------------------------------------------------------- payments --
#
# Which gateway the store takes payment through. `skipcash` is the only one;
# leave it empty and checkout says payments are not switched on — the safe
# default. See src/payments/skipcash/.
PAYMENT_PROVIDER=skipcash

# ---- SkipCash ----
#
# Four keys per environment, from the Merchant Portal → Online Payments
# (generate a private key there). Sandbox keys may be shared in chat; LIVE keys
# only through a one-time secure link, never chat or email.
#
# SKIPCASH_ENV — `sandbox` (skipcashtest.azurewebsites.net) or `production`
# (api.skipcash.app). Anything but exactly `production` is the sandbox.
#
# Webhooks: SkipCash must reach the site over the internet, so it cannot call
# localhost. On a public https address the store sends its own webhook URL
# with every payment (/api/payments/skipcash/webhooks); locally the return
# page settles the order instead, and the e2e suite signs callbacks itself.
SKIPCASH_ENV=sandbox
SKIPCASH_CLIENT_ID=
SKIPCASH_KEY_ID=
SKIPCASH_KEY_SECRET=
SKIPCASH_WEBHOOK_KEY=

# ------------------------------------------------------------------- email --
#
# Order confirmations, new-order alerts, shipped emails and password resets,
# through Resend (resend.com). Leave RESEND_API_KEY empty and nothing is sent —
# Payload prints emails to the console instead. See src/email/config.ts.
#
# EMAIL_FROM's domain must be verified in Resend. Until the client adds the DNS
# records for plumpose.com, use onboarding@resend.dev — which Resend will only
# deliver to the address that owns the Resend account.
RESEND_API_KEY=
EMAIL_FROM="plumpose <onboarding@resend.dev>"
# Testing only: send EVERY email to this one address instead of the customer.
# Never set in production.
EMAIL_TEST_RECIPIENT=

# ------------------------------------------------------------------- media --
#
# Photographs go to the Cloudflare R2 bucket below when MEDIA_STORAGE=r2 (the
# host, and this machine now that it works on the live data); otherwise to
# local disk (public/media). The bucket is private: the site serves them as /api/media/file/<name>. Films are copied from
# the same bucket into public/video before each build (pnpm films:fetch).
# See src/storage/r2.ts and scripts/films.ts.
MEDIA_STORAGE=r2
R2_ACCOUNT_ID=
R2_BUCKET=
# `eu` for a bucket created under the EU jurisdiction; empty otherwise.
R2_JURISDICTION=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Demo catalogue photos (pnpm demo:seed), development only — free key at pexels.com/api
PEXELS_API_KEY=
