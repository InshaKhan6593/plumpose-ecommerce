# plumpose — copy to .env and fill in.

PAYLOAD_SECRET=generate-a-long-random-string

# Postgres. The README's docker command publishes 5432 inside the container
# on 5434 on the host, so the port here is the host one.
DATABASE_URL=postgres://plumpose:plumpose@localhost:5434/plumpose

NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Used to preview drafts from the admin.
PREVIEW_SECRET=change-me

# ---------------------------------------------------------------- payments --
#
# Which gateway the store takes payment through.
#
#   stripe    — development harness ONLY. Refuses to load when NODE_ENV is
#               production. See src/payments/stripeSandbox.ts.
#   skipcash  — the real gateway. Not implemented yet; pending credentials.
#
# Leave empty and the store has no payment method, which is the safe default.
PAYMENT_PROVIDER=stripe

# ---- Stripe (sandbox, development only) ----
#
# Test keys from dashboard.stripe.com in TEST mode — they start sk_test_ and
# pk_test_. Never put live keys here.
#
# Webhooks cannot reach localhost, so forward them with the Stripe CLI:
#
#   stripe login
#   pnpm stripe-webhooks
#
# That prints a signing secret starting whsec_ — put it in the third value
# below. It changes each time you start the listener.
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_

# ------------------------------------------------------------------- email --
#
# Order confirmations, new-order alerts, shipped emails and password resets,
# through Resend (resend.com). Leave RESEND_API_KEY empty and nothing is sent —
# Payload prints emails to the console instead. See src/email/config.ts.
#
# EMAIL_FROM's domain must be verified in Resend. Until the client adds the DNS
# records for plumpose.com, use onboarding@resend.dev — which Resend will only
# deliver to the address that owns the Resend account.
RESEND_API_KEY=
EMAIL_FROM="plumpose <onboarding@resend.dev>"
# Testing only: send EVERY email to this one address instead of the customer.
# Never set in production.
EMAIL_TEST_RECIPIENT=

# ---- SkipCash — REQUEST FROM CLIENT, blocking for launch ----
#
# Also confirm which environment the existing live site points at.
# SkipCash webhooks need a publicly reachable URL, so test them against a
# deploy preview rather than localhost.
SKIPCASH_ENV=sandbox
SKIPCASH_CLIENT_ID=
SKIPCASH_KEY_ID=
SKIPCASH_KEY_SECRET=
SKIPCASH_WEBHOOK_KEY=
