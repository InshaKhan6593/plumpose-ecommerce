{
  "name": "plumpose",
  "version": "1.0.0",
  "description": "plumpose — luxury silk sleepwear store",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "audit:admin": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/audit-admin.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "shoot:one": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/shoot-one.ts",
    "shoot:admin": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/shoot-admin.ts",
    "test-shots": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/import-test-shots.ts",
    "seed": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/run.ts",
    "demo:seed": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/demo-catalogue.ts seed",
    "demo:remove": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx scripts/demo-catalogue.ts remove",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "films:upload": "tsx scripts/films.ts upload",
    "films:fetch": "tsx scripts/films.ts fetch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@payloadcms/admin-bar": "3.90.1",
    "@payloadcms/db-postgres": "3.90.1",
    "@payloadcms/email-resend": "3.90.1",
    "@payloadcms/live-preview-react": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/plugin-ecommerce": "3.90.1",
    "@payloadcms/plugin-form-builder": "3.90.1",
    "@payloadcms/plugin-seo": "3.90.1",
    "@payloadcms/richtext-lexical": "3.90.1",
    "@payloadcms/storage-s3": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^8.2.0",
    "embla-carousel-auto-scroll": "^8.1.5",
    "embla-carousel-react": "^8.5.2",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "0.563.0",
    "next": "16.3.3",
    "payload": "3.90.1",
    "prism-react-renderer": "^2.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.71.1",
    "sharp": "0.35.4",
    "sonner": "^1.7.2",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "tsx": "4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.2",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
